;; ---- Core article claims ----

;; Claim 1: Pragmatic patternism
(--> pragmatic-patternism ([] (intelligence goals-in-environments pattern-primitive)))
(--> pattern ([] (representation simpler-than-represented compressed)))

;; Claim 2: Structural property
(--> general-intelligence ([] (structural-property not-algorithm organization-of-computation)))
(--> gi-substrate-independence ([] (not-about-substrate about-organization)))

;; Claim 3: Category-theoretic formalization
(--> intelligence-functor ([] (functor environment-category action-category)))
(--> learning-natural-transformation ([] (natural-transformation F1 F2 adaptation)))
(--> self-modification-endofunctor ([] (endofunctor intelligence-category self-reshape)))

;; Claim 4: Metatransparency
(--> metatransparency ([] (inspect-modify-own-processes understand-why)))
(==> (--> $agent ([] generally-intelligent))
     (--> $agent ([] metatransparent)))

;; Claim 5: Goal diversity and transfer
(--> goal-diversity ([] (multiple-goals multiple-environments generality)))
(--> transfer-learning ([] (cross-domain pattern-reuse essential-for-AGI)))

;; Claim 6: Cognitive synergy
(--> cognitive-synergy ([] (multiple-processes interaction emergent-capabilities)))
(--> synergy-components ([] (attention perception reasoning memory learning action)))
(==> (--> $system ([] cognitive-synergy))
     (--> $system ([] capabilities-beyond-individual-modules)))

;; Claim 7: CogPrime/Hyperon
(--> cogprime-hyperon ([] (implements cognitive-synergy PLN MOSES pattern-mining)))
(--> atomspace ([] (shared-hypergraph knowledge-substrate)))

;; Claim 8: Pattern = compressed representation
(--> pattern-definition ([] (shorter-description-length relative-to-reference-model)))

;; ---- Hyperseed ontology interpretations ----

;; Claim 9: Intelligence = fiber richness
(--> intelligence-fiber ([] (thick diverse many-response-patterns)))
(--> narrow-ai-fiber ([] (thin few-responses small-coverage)))
(--> agi-fiber ([] (thick many-responses large-coverage)))

;; Claim 10: Fiber diversity = cognitive synergy
(--> fiber-type-diversity ([] (perception-fiber reasoning-fiber action-fiber memory-fiber)))
(==> (--> (× $fiber1 $fiber2) ([] interacting-fiber-types))
     (--> (× $fiber1 $fiber2) ([] emergent-fiber-structure)))

;; Claim 11: Fiber coverage = generality
(--> fiber-coverage ([] (portion-of-base-space generality-measure)))

;; Claim 12: Functor = fiber bundle morphism
(--> intelligence-functor-fiber ([] (fiber-bundle-morphism env-to-action structure-preserving)))

;; Claim 13: Learning = fiber homotopy
(--> learning-homotopy ([] (continuous-deformation intelligence-morphism adaptation)))

;; Claim 14: Self-modification = fiber endomorphism
(--> self-mod-endomorphism ([] (reshape-own-fiber-structure autopoietic)))

;; Claim 15: Metatransparency = meta-fiber
(--> meta-fiber ([] (section-over-own-bundle self-understanding)))
(==> (--> $system ([] has-meta-fiber))
     (--> $system ([] metatransparent)))

;; Claim 16: Transfer learning = low curvature (d-calculus)
(--> transfer-learning-curvature ([] (low-curvature good-transport cross-domain)))
(==> (--> $connection ([] low-intelligence-curvature))
     (--> $connection ([] good-pattern-transfer)))

;; Claim 17: Cognitive synergy curvature
(--> synergy-curvature ([] (nonzero whole-exceeds-sum)))
(==> (--> $connection ([] flat-cognitive))
     (--> $connection ([] independent-modules-no-synergy)))
(==> (--> $connection ([] curved-cognitive))
     (--> $connection ([] synergistic-interaction)))

;; Claim 18: Self-modification holonomy
(--> self-mod-holonomy ([] (task-loop genuine-learning-vs-cycling)))
(==> (--> $loop ([] nontrivial-self-mod-holonomy))
     (--> $loop ([] genuine-learning)))

;; Claim 19: Pattern = flat section
(--> pattern-flat-section ([] (captures-local-structure ignores-curvature)))
(--> pattern-recognition ([] (constructing-flat-sections)))
(--> pattern-creation ([] (extending-flat-sections new-base-regions)))

