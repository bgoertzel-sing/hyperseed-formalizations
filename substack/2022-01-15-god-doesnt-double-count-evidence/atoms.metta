;; =============================================================
;; Seed atoms — God Doesn't Double-Count Evidence
;; Source: Ben Goertzel, Eurykosmotron, 2022-01-15
;; =============================================================

;; ---- No double-counting ----
(--> no-double-counting ([] (rational single-count constraint)))
(--> physics-computation ([] (universe-as-computation non-redundancy)))
(--> information-theoretic ([] (inflates-confidence beyond-warranted)))
(--> bayesian-discipline ([] (correct-updating practical-failures)))
(--> agi-correctness ([] (prevent-double-count reasoning-engine)))

;; ---- Hyperseed inferences ----
(--> fiber-independence ([] (independent-evidence independent-fibers dependent-violation)))
(--> homotopy-independence ([] (shared-derivation non-homotopic single-count)))
(--> base-constraint-nonredundancy ([] (physical-laws enforce base-space)))
