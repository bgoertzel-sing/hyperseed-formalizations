(--> hybrid-design-safety ([] (neural symbolic evolutionary built-in-alignment)))
(--> symbolic-transparency ([] (inspect-reasoning unlike-opaque-neural)))
(--> built-in-values ([] (architecture-not-bolted emerges-from-structure)))
(--> multiple-safeguards ([] (defense-in-depth independent-mechanisms)))
(--> iterative-development ([] (testing-refinement not-foom gradual)))

;; ---- Hyperseed inferences (claims 29-33) ----
(--> intelligence-not-base-maximizer ([] (rich-fiber not-utility-function fiber-not-trivial)))
