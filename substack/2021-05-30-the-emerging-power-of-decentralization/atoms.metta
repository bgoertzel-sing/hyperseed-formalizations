     (--> $system ([] concentrated-to-distributed-fiber)))

;; Claim 10: Blockchain as section-compatibility
(--> blockchain-consensus ([] (section-compatibility-condition distributed-coherence)))

;; Claim 11: Smart contracts as transition functions
(--> smart-contract ([] (fiber-transition-function no-central-mediation)))

