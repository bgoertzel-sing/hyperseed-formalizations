;; ---- Core article claims ----

;; Claim 1: Political organization needed
(--> singularitarian-politics ([] (organized-movement policy-influence needed)))
(--> individual-advocacy ([] (insufficient scattered no-collective-power)))

;; Claim 2: Key policy positions
(--> singularitarian-policies ([] (fund-agi life-extension space open-science ubi cognitive-liberty)))
(--> ai-regulation-stance ([] (oppose-overly-restrictive support-beneficial)))

;; Claim 3: Beyond left-right
(--> singularitarianism-political ([] (orthogonal-to-left-right new-dimension future-of-intelligence)))
(--> political-orthogonality ([] (not-left not-right perpendicular)))

;; Claim 4: Democratic engagement
(--> democratic-approach ([] (persuasion education participation not-technocratic)))
(--> public-case ([] (make-argument openly not-impose)))

;; Claim 5: Urgency
(--> political-window ([] (limited pre-agi organize-now)))
(==> (--> $time ([] post-agi-transition))
     (--> political-landscape ([] transformed-at $time)))

;; Claim 6: Global perspective
(--> global-movement ([] (not-national agi-affects-everyone)))
(--> national-insufficiency ([] (global-problem needs-global-response)))

;; Claim 7: Coalition building
(--> coalition-strategy ([] (align-interests avoid-purity progressive libertarian futurist)))

;; ---- Hyperseed ontology interpretations ----

;; Claim 8: Fiber coordination
(--> political-fiber-coordination ([] (scattered-to-bundled emergent-capability)))
(==> (--> (× $f1 $f2) ([] politically-bundled))
     (--> (× $f1 $f2) ([] emergent-political-power)))

;; Claim 9: Orthogonal political fiber
(--> orthogonal-political-fiber ([] (new-dimension perpendicular-to-spectrum)))
(--> singularitarian-axis ([] (future-intelligence-consciousness not-economics-culture)))

;; Claim 10: Fiber window
(--> fiber-plasticity ([] (pre-agi shapeable post-agi potentially-locked)))
(==> (--> $phase ([] pre-transition))
     (--> political-fiber ([] plastic-in $phase)))
(==> (--> $phase ([] post-transition))
     (--> political-fiber ([] potentially-locked-in $phase)))

;; Claim 11: Coalition curvature (d-calculus)
(--> coalition-curvature ([] (between-political-fibers compromise-cost)))
(==> (--> (× $fiber1 $fiber2) ([] low-coalition-curvature))
     (--> (× $fiber1 $fiber2) ([] easy-coalition)))
(==> (--> (× $fiber1 $fiber2) ([] high-coalition-curvature))
     (--> (× $fiber1 $fiber2) ([] difficult-but-powerful-coalition)))

;; Claim 12: Democratic holonomy (d-calculus)
(--> democratic-governance-holonomy ([] (propose-debate-vote-implement-evaluate)))
(==> (--> $cycle ([] nontrivial-democratic-holonomy))
     (--> $cycle ([] genuine-political-evolution)))
(==> (--> $cycle ([] trivial-democratic-holonomy))
     (--> $cycle ([] mere-political-cycling)))

;; Claim 13: Urgency as curvature acceleration (d-calculus)
(--> urgency-curvature ([] (d2F-dt2-positive accelerating harder-and-more-important)))

;; Claim 14: Global fiber coverage (d-calculus)
(--> global-fiber-coverage ([] (full-geopolitical-base robust-to-national-perturbation)))

