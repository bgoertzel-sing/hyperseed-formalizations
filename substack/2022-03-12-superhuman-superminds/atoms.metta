;; =============================================================
;; Seed atoms — How Superhuman Superminds Will Mostly Be Nice
;; Source: Ben Goertzel, Eurykosmotron, 2022-03-12
;; Deepened: 2026-09-19 (Hyperseed v2 / d-calculus)
;; =============================================================

;; ---- Core article claims ----

;; Claim 1: Superminds not singleton
(--> supermind ([] (network interacting-minds emergent not-monolithic)))
(--> supermind-structure ([] (composed-agents interaction-connections)))

;; Claim 2: Cooperation dominates at scale
(--> cooperation-at-scale ([] (game-theory-favors long-time-horizon accurate-modeling)))
(==> (--> $agents ([] superhuman-intelligence))
     (--> (cooperation-benefit $agents) ([] overwhelming)))

;; Claim 3: Intelligence correlates with empathy
(--> intelligence-empathy ([] (greater-capacity greater-perspective-taking)))
(--> empathy-as-capability ([] (modeling-others intelligence-proportional)))

;; Claim 4: Evil requires stupidity
(--> evil-requires-limitation ([] (cant-see-consequences cant-model-others)))
(==> (--> $agent ([] superintelligent))
     (--> $agent ([] sees-consequences-of-defection)))

;; Claim 5: Exceptions exist
(--> pathological-superminds ([] (possible statistically-subordinate analogous-to-psychopaths)))

;; Claim 6: Not naive optimism
(--> structural-benevolence ([] (game-theory information-theory not-wishful)))

;; ---- Hyperseed ontology interpretations ----

;; Claim 7: Supermind = composed fiber bundle
(--> supermind-fiber ([] (composed-bundle interaction-connections emergent-fiber)))
(--> E-super ([] (direct-sum-Ei plus-Gamma-ij)))

;; Claim 8: Cooperation = fiber sharing
(--> cooperation-fiber-sharing ([] (shared-knowledge shared-models richer-composition)))
(--> competition-fiber-hoarding ([] (private-knowledge limited-individual)))
(==> (--> $agents ([] cooperative))
     (--> (composed-fiber $agents) ([] richer-than-individual)))

;; Claim 9: Empathy = fiber modeling
(--> empathy-fiber-model ([] (agent-models-other accuracy-fidelity)))
(==> (--> $agent ([] more-intelligent))
     (--> (empathy-model $agent) ([] more-accurate)))

;; Claim 10: Composition curvature (d-calculus)
(--> composition-curvature ([] (cooperation-difficulty boundary-friction)))
(--> low-composition-curvature ([] (compatible-fibers easy-cooperation)))
(--> high-composition-curvature ([] (incompatible-fibers difficult-cooperation)))

;; Claim 11: Cooperation holonomy (d-calculus)
(--> cooperation-holonomy ([] (propose-negotiate-agree-execute-evaluate)))
(==> (--> $cycle ([] cooperative))
     (--> (Hol $cycle Gamma-coop) ([] nontrivial new-shared-fiber)))

;; Claim 12: Evil as high empathy curvature (d-calculus)
(--> evil-empathy-curvature ([] (high-curvature perspective-transport-failure)))
(==> (--> (F-nabla-empathy $agent) ([] divergent))
     (--> $agent ([] harm-possible)))

;; Claim 13: Pathological curvature (d-calculus)
(--> empathy-singularity ([] (locally-smooth globally-disconnected psychopathic)))
(--> singularity-penalized ([] (cooperation-advantage selects-against)))

;; Claim 14: Benevolence gradient (d-calculus)
(--> benevolence-gradient ([] (maximal-cooperative-advantage structural-attractor)))
(--> benevolence-basin ([] (large steep superhuman-scale)))

;; ---- Cross-references ----
(--> superhuman-superminds ([] (related-to beneficial-agi designed-plus-structural)))
(--> superhuman-superminds ([] (related-to open-ended-motivations growth-favors-cooperation)))
(--> superhuman-superminds ([] (related-to consciousness-explosion empathy-requires-consciousness)))

