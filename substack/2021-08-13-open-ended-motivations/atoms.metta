;; ---- Core article claims ----

;; Claim 1: Against fixed objectives
(--> fixed-utility ([] (freezes-values prevents-growth premature-commitment)))
(--> fixed-objective-inadequacy ([] (time-locked obsolescent)))

;; Claim 2: Open-ended goals
(--> open-ended-goals ([] (evolving meta-goal-of-better-goals)))
(--> meta-goal-evolution ([] (goal-generating-process-evolves)))

;; Claim 3: Growth as motivation
(--> growth-motivation ([] (cognitive ethical experiential meta-motivation)))
(--> growth-not-fixed ([] (not-reducible-to-objective)))

;; Claim 4: Joy, growth, choice
(--> joy-growth-choice ([] (fundamental-triad open-ended)))
(--> joy ([] (positive-signal motivation-axis)))
(--> growth-axis ([] (direction motivation-axis)))
(--> choice-axis ([] (agency motivation-axis)))

;; Claim 5: Not relativism
(--> open-ended-not-relativism ([] (direction-without-destination better-evolves)))

;; Claim 6: Avoiding wireheading
(--> anti-wireheading ([] (goals-evolve-past-shortcut no-stable-hack)))

;; ---- Hyperseed ontology interpretations ----

;; Claim 7: Fixed utility = frozen fiber
(--> frozen-fiber ([] (unchanging increasingly-misaligned obsolete-criteria)))
(==> (--> $fiber ([] frozen))
     (--> (alignment-gap $fiber) ([] grows-with-time)))

;; Claim 8: Open-ended motivation = fiber evolution
(--> motivational-fiber-evolution ([] (dF-dt-nonzero meta-guided)))

;; Claim 9: Meta-motivational fiber
(--> F-meta ([] (governs-F-M-evolution open-to-meta-meta)))

;; Claim 10: Autopoietic motivation
(--> autopoietic-motivation ([] (self-producing growth-opens-dimensions)))

;; Claim 11: Motivational flow (d-calculus)
(--> motivational-flow ([] (vector-field-V state-dependent nonlinear)))
(--> joy-growth-choice-attractors ([] (prevent-pathological-divergence)))

;; Claim 12: Growth curvature (d-calculus)
(--> motivational-curvature ([] (context-sensitivity moderate-optimal)))
(--> low-mot-curvature ([] (stable slow-varying)))
(--> high-mot-curvature ([] (chaotic unstable)))

;; Claim 13: Anti-wireheading holonomy (d-calculus)
(--> anti-wireheading-holonomy ([] (nontrivial-all-loops no-equilibrium)))
(==> (--> $gamma ([] nontrivial-motivational-loop))
     (--> (Hol $gamma nabla-M) ([] nontrivial)))

;; Claim 14: Joy-growth-choice gradient (d-calculus)
(--> meta-gradient ([] (three-component joy growth choice)))
(--> direction-without-destination ([] (well-defined-gradient evolving-goals)))

;; Claim 15: Fiber thickening rate (d-calculus)
(--> fiber-thickening ([] (monotonic-dim-increase growth-not-mere-change)))
(==> (--> $system ([] open-ended-motivated))
     (--> (d-dim-F-dt $system) ([] positive)))

