;; ---- Core article claims ----

;; Claim 1: Interzones as creative spaces
(--> interzones ([] (creative between-categories contradictions-coexist)))
(--> interzone-productivity ([] (most-interesting intellectually-fertile)))

;; Claim 2: Burroughs' Interzone
(--> burroughs-interzone ([] (liminal ungoverned generative between-control-systems)))

;; Claim 3: Paraconsistency enables interzones
(--> paraconsistency-for-interzones ([] (prevents-explosion contradictions-productive)))
(==> (not (--> $logic ([] paraconsistent)))
     (--> (interzone-in $logic) ([] collapsed-trivial)))

;; Claim 4: Interdisciplinary parallels
(--> interdisciplinary-interzones ([] (boundary-science methods-clash productive)))

;; Claim 5: AGI should inhabit interzones
(--> agi-interzone-native ([] (paraconsistent-reasoning contradiction-productive)))

;; Claim 6: Control vs freedom
(--> interzone-liminal ([] (between-jurisdictions between-paradigms generative)))

;; ---- Hyperseed ontology interpretations ----

;; Claim 7: Interzone = fiber overlap region
(--> interzone-fiber-overlap ([] (two-bundles-overlap contradiction-zone)))
(--> paraconsistent-product ([] (holds-both-sections no-collapse)))

;; Claim 8: Creativity = interzone navigation
(--> creativity-navigation ([] (dual-connections simultaneous novel-synthesis)))

;; Claim 9: Novel fiber from interzones
(--> interzone-novel-fiber ([] (not-in-either-bundle creative-insight mechanism)))

;; Claim 10: Interzone curvature (d-calculus)
(--> interzone-curvature ([] (competing-connections high divergent-transport)))
(--> interzone-F ([] (Gamma1-minus-Gamma2 bracket-term productive-tension)))

;; Claim 11: Paraconsistent connection (d-calculus)
(--> Gamma-para ([] (blended alpha-weighted synthesis-component)))
(--> Gamma-synthesis ([] (creative-contribution interzone-only novel)))

;; Claim 12: Interzone holonomy (d-calculus)
(--> interzone-holonomy ([] (maximal-nontrivial crossing-transformative)))
(==> (--> $loop ([] crosses-interzone))
     (--> (Hol $loop Gamma-para) ([] maximally-nontrivial)))

;; Claim 13: Control boundary curvature (d-calculus)
(--> control-boundary-curvature ([] (transition-sharpness consistent-to-paraconsistent)))
(--> sharp-boundary ([] (high-curvature hard-to-enter)))
(--> gradual-boundary ([] (low-curvature easy-navigation)))

;; Claim 14: Interzone gradient (d-calculus)
(--> interzone-gradient ([] (points-to-productive-contradictions skill-dependent)))
(==> (--> $thinker ([] skilled-interdisciplinary))
     (--> $thinker ([] follows-interzone-gradient)))

