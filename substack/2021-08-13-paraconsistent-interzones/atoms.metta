;; ---- Core article claims ----

;; Claim 1: Interzones as creative spaces
(--> interzones ([] (creative between-categories contradictions-coexist)))
(--> interzone-productivity ([] (most-interesting intellectually-fertile)))

;; Claim 2: Burroughs' Interzone
(--> burroughs-interzone ([] (liminal ungoverned generative between-control-systems)))

;; Claim 3: Paraconsistency enables interzones
(--> paraconsistency-for-interzones ([] (prevents-explosion contradictions-productive)))
(==> (not (--> $logic ([] paraconsistent)))
     (--> (interzone-in $logic) ([] collapsed-trivial)))

;; Claim 4: Interdisciplinary parallels
(--> interdisciplinary-interzones ([] (boundary-science methods-clash productive)))

;; Claim 5: AGI should inhabit interzones
(--> agi-interzone-native ([] (paraconsistent-reasoning contradiction-productive)))

;; Claim 6: Control vs freedom
(--> interzone-liminal ([] (between-jurisdictions between-paradigms generative)))

;; ---- Hyperseed ontology interpretations ----

