(--> interzone-curvature ([] (competing-connections high divergent-transport)))
(--> interzone-F ([] (Gamma1-minus-Gamma2 bracket-term productive-tension)))

;; Claim 11: Paraconsistent connection (d-calculus)
(--> Gamma-para ([] (blended alpha-weighted synthesis-component)))
(--> Gamma-synthesis ([] (creative-contribution interzone-only novel)))

