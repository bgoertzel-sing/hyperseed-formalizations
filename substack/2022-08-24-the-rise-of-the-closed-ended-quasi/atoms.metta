;; =============================================================
;; Seed atoms — The Rise of the Closed-Ended Quasi-AGI
;; Source: Ben Goertzel, Eurykosmotron, 2022-08-24
;; Deepened: 2026-09-19 (Hyperseed v2 / d-calculus)
;; =============================================================

;; ---- Core article claims ----

;; Claim 1: Closed-ended quasi-AGI defined
(--> closed-ended-quasi-agi ([] (broad-competence bounded training-distribution)))
(--> quasi-agi ([] (interpolates-impressively no-genuine-extrapolation)))

;; Claim 2: Impressive within bounds
(--> quasi-agi-competence ([] (real useful within-training-distribution)))
(--> bounded-competence ([] (not-illusion but-not-open-ended)))

;; Claim 3: Missing open-endedness
(--> open-ended-intelligence ([] (novel-situations new-concepts self-modification)))
(--> true-agi-requirements ([] (architecture-modification unprecedented-transfer)))
(==> (--> $system ([] closed-ended))
     (not (--> $system ([] handles-genuine-novelty))))

;; Claim 4: Dangerous conflation
(--> quasi-agi-conflation ([] (false-confidence wrong-policy misallocated-research)))
(==> (--> $observer ([] conflates-quasi-with-true-agi))
     (--> $observer ([] systematically-wrong-predictions)))

;; Claim 5: Hybrid path
(--> hybrid-agi-path ([] (quasi-as-component add-reasoning add-self-modification)))
(--> cognitive-integration ([] (llm-plus-reasoning-plus-planning open-ended)))

;; Claim 6: Historical pattern
(--> ai-breakthrough-pattern ([] (mistaken-for-agi then-understood-as-component)))
(--> pattern-instances ([] (expert-systems neural-nets deep-learning llms)))

;; ---- Hyperseed ontology interpretations ----

;; Claim 7: Bounded fiber
(--> bounded-fiber ([] (fixed-at-training cannot-extend)))
(==> (--> $system ([] bounded-fiber))
     (--> (fiber $system $t) ([] subset-of F-training)))

;; Claim 8: Growing fiber
(--> growing-fiber ([] (autopoietic new-dimensions novelty-response)))
(==> (--> $system ([] growing-fiber))
     (--> (partial-t (dim (fiber $system $t))) ([] positive)))

;; Claim 9: Interpolation = convex hull
(--> quasi-agi-interpolation ([] (convex-hull training-fibers impressive-but-bounded)))

;; Claim 10: Extrapolation = fiber growth
(--> agi-extrapolation ([] (beyond-convex-hull autopoietic-creation)))

;; Claim 11: Conflation = fiber-type error
(--> fiber-type-error ([] (bounded-mistaken-for-growing in-distribution-indistinguishable)))
(==> (--> $point ([] within-training-distribution))
     (--> (× bounded-fiber growing-fiber) ([] indistinguishable-at $point)))
(==> (--> $point ([] beyond-training-boundary))
     (--> (× bounded-fiber growing-fiber) ([] divergent-at $point)))

;; Claim 12: Fiber growth rate (d-calculus)
(--> fiber-growth-rate ([] (tangent-bundle-section d-calculus)))
(--> quasi-agi-growth ([] (partial-F-partial-t zero static)))
(--> true-agi-growth ([] (partial-F-partial-t positive dynamic)))

;; Claim 13: Boundary curvature (d-calculus)
(--> training-boundary ([] (hypersurface fiber-space)))
(--> boundary-curvature ([] (competence-dropoff-sharpness)))
(--> high-boundary-curvature ([] (competence-cliff expert-to-clueless)))
(--> low-boundary-curvature ([] (gradual-degradation graceful)))

;; Claim 14: Autopoietic connection (d-calculus)
(--> autopoietic-connection ([] (evolving new-transport-paths true-agi)))
(--> static-connection ([] (fixed-at-training quasi-agi)))

;; Claim 15: Novelty curvature (d-calculus)
(--> novelty-curvature ([] (fiber-curvature-at-base novelty-measure)))
(==> (--> $point ([] high-novelty-curvature))
     (--> quasi-agi ([] fails-at $point)))
(==> (--> $point ([] high-novelty-curvature))
     (--> true-agi ([] adapts-at $point)))

