;; =============================================================
;; Seed atoms — Is ChatGPT Real Progress Toward Human-Level AGI?
;; Source: Ben Goertzel, Eurykosmotron, 2023-01-18
;; =============================================================

;; ---- ChatGPT evaluation ----
(--> chatgpt-fluency ([] (impressive broad language-coverage)))
(--> pattern-matching-not-understanding ([] (sophisticated shortcut not-genuine)))
(--> missing-persistent-memory ([] (no-memory across-conversations)))
(--> missing-embodiment ([] (disembodied text-only no-grounding)))
(--> missing-robust-reasoning ([] (unreliable multi-step novel-fails)))
(--> scaling-limits ([] (quantitative not-qualitative insufficient)))
(--> hybrid-architectures ([] (multiple-paradigms combined needed)))

;; ---- Hyperseed inferences ----
(--> fiber-shortcut ([] (input-to-output no-traversal no-understanding)))
(--> thin-fiber-chatgpt ([] (broad-base thin-depth key-dimensions)))
(--> multi-fiber-agi ([] (neural symbolic embodied integrated)))
