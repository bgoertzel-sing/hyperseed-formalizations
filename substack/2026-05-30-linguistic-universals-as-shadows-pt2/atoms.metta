;; ---- Five correspondences (claims 10-15) ----
(--> factorization-identity TransportTheorem)
(--> closure-transport TransportTheorem)
(--> sparse-energy-pushforward TransportTheorem)
(--> stability-rate-transport TransportTheorem)
(--> glued-closure-transport TransportTheorem)

(--> factorization-identity ([] (strongest identity-theorem disjoint-commute tug-swap-equivalent)))
