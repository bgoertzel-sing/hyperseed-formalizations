(--> closure-transport ([] (pushforward closure-to-closure fixed-points-correspond)))
(--> sparse-energy-pushforward ([] (marginalize-non-externalizing preserves-sparsity local-map)))
(--> stability-rate-transport ([] (linguistic-stability-coefficient image-of-cognitive-stability)))
(--> glued-closure-transport ([] (local-operators glue-via-transition-maps respects-closure)))

