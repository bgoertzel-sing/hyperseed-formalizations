;; =============================================================
;; Seed atoms — Three Viable Paths to True AGI
;; Source: Ben Goertzel, Eurykosmotron, 2022-08-25
;; Deepened: 2026-09-19 (Hyperseed v2 / d-calculus)
;; =============================================================

;; ---- Core article claims ----

;; Claim 1: Hybrid neural-symbolic
(--> hybrid-neural-symbolic ([] (combined neural symbolic cognitive-synergy)))
(--> hyperon-architecture ([] (implements hybrid integrated)))
(--> neural-component ([] (perception pattern-recognition fuzzy-generalization)))
(--> symbolic-component ([] (reasoning planning knowledge-representation)))

;; Claim 2: Brain emulation
(--> brain-emulation ([] (scan simulate reproduce-cognition)))
(--> emulation-requirements ([] (neuroscience scanning-tech computation)))

;; Claim 3: Evolutionary/developmental
(--> evolutionary-agi ([] (artificial-evolution developmental-learning embodied)))
(--> evolution-advantage ([] (discovers-novel-architectures)))

;; Claim 4: Complementary paths
(--> three-paths-complementary ([] (inform-each-other cross-pollination)))
(--> emulation-to-hybrid ([] (reveals-what-works reference-architecture)))
(--> evolution-to-hybrid ([] (discovers-novel-compositions)))
(--> hybrid-to-evolution ([] (interpretable-fitness-landscape)))

;; Claim 5: Risk profiles differ
(--> hybrid-risks ([] (design-errors integration-failures incomplete-synergy)))
(--> emulation-risks ([] (unknown-requirements scan-resolution zombie-risk)))
(--> evolution-risks ([] (unpredictable alignment-difficulty long-timelines)))

;; Claim 6: Scaling ≠ AGI
(--> scaling-not-agi ([] (quantitative-not-qualitative architectural-innovation-needed)))
(==> (--> $approach ([] pure-scaling))
     (not (--> $approach ([] path-to-true-agi))))

;; Claim 7: Resource misallocation
(--> ai-funding ([] (overwhelmingly-llm-scaling misallocated)))

;; ---- Hyperseed ontology interpretations ----

;; Claim 8: Designed fiber (hybrid)
(--> designed-fiber ([] (explicit-composition neural-symbolic-memory-action)))
(--> composition-challenge ([] (emergent-from-component-fibers cognitive-synergy)))

;; Claim 9: Copied fiber (emulation)
(--> copied-fiber ([] (biological-scan computational-replica)))
(--> copy-challenge ([] (essential-vs-artifact-fiber faithful-reproduction)))

;; Claim 10: Evolved fiber (evolutionary)
(--> evolved-fiber ([] (selection-on-variation emergent-architecture)))
(--> evolution-challenge ([] (slow unpredictable possibly-incomprehensible)))

;; Claim 11: Fiber cross-pollination
(--> fiber-cross-pollination ([] (reference-fiber novel-compositions interpretable-landscapes)))

;; Claim 12: Construction curvature (d-calculus)
(--> designed-curvature ([] (interface-boundaries neural-symbolic-junctions)))
(--> copied-curvature ([] (biological evolution-smoothed faithful-reproduction)))
(--> evolved-curvature ([] (unpredictable functionally-effective)))

;; Claim 13: Fiber growth dynamics (d-calculus)
(--> designed-growth ([] (modular controllable deliberate)))
(--> copied-growth ([] (biological-plasticity synaptic-modification)))
(--> evolved-growth ([] (generational slow parallelizable)))

;; Claim 14: Holonomy signatures (d-calculus)
(--> designed-holonomy ([] (reflects-architecture deliberate-choices)))
(--> copied-holonomy ([] (mirrors-biological developmental-history)))
(--> evolved-holonomy ([] (reflects-selection evolutionary-pressures)))

;; Claim 15: Scaling curvature divergence (d-calculus)
(--> scaling-curvature ([] (volume-increases curvature-unchanged)))
(==> (--> $system ([] fixed-curvature-architecture))
     (not (--> (scale $system) ([] new-curvature-patterns))))
(--> agi-curvature-requirement ([] (cognitive-synergy self-modification-holonomy specific-patterns)))

