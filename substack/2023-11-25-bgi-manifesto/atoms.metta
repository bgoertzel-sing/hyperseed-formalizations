(--> bgi-manifesto ([] (related-to bgi-summit intellectual-foundation)))
(--> bgi-manifesto ([] (related-to superhuman-superminds structural-benevolence)))
(--> bgi-manifesto ([] (related-to open-ended-motivations architectural-values)))
