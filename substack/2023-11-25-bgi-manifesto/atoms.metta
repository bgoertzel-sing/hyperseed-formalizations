;; ---- Core article claims ----

(--> hlagi-near ([] (clear-problems solid-routes asi-follows)))
(--> intelligence-explosion ([] (self-study self-improvement rapid-singularity)))
(--> beneficial-vs-dangerous ([] (who-builds what-values determines-outcome)))
(--> open-development ([] (open-source decentralized transparency scrutiny)))
(--> against-restriction ([] (concentrates-power actual-danger regulatory-capture)))
(--> architectural-alignment ([] (design-not-bolted values-from-structure)))

;; ---- Hyperseed ontology interpretations ----

(--> bgi-beneficial-fiber ([] (capability-coupled-to-flourishing)))
(==> (--> $system ([] bgi-architecture))
     (and (--> (capability $system) ([] growing))
          (--> (flourishing $system) ([] growing))))

(--> architectural-vs-bolted ([] (integral vs peelable-bypassable)))
(--> bolted-alignment ([] (separate-constraint-fiber can-slip)))
(--> architectural-alignment-fiber ([] (capability-is-beneficial inseparable)))

(--> fiber-integrity ([] (preserved-under-self-modification)))
(==> (--> $system ([] self-modifying-bgi))
     (--> (beneficial-properties $system) ([] preserved)))

(--> fiber-autocatalysis ([] (self-modifying accelerating each-cycle-better)))

(--> fiber-transparency ([] (inspectable verifiable community-checked)))
(--> fiber-monopoly ([] (single-dominance reduced-diversity concentrated-power)))

;; ---- d-calculus claims ----

(--> bgi-curvature ([] (capability-benefit-coupling low-means-good)))
(--> autocatalytic-holonomy ([] (preserves-beneficial-subspace value-aligned)))
(==> (--> (Hol $gamma Gamma-self-modify) ([] preserves-beneficial))
     (--> $gamma ([] safe-self-improvement)))

(--> monopoly-curvature ([] (dangerous-concentration sharp-boundary)))
(--> open-curvature ([] (low-distributed no-concentration)))

(--> manifesto-as-connection ([] (defines-target connects-current-to-beneficial)))

